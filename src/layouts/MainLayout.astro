---
import BasicHead from "@components/BasicHead.astro";
import TopNavigation from "@components/Navigation/TopNavigation.vue";

interface Props {
	title?: string;
	desc?: string;
}

const { title, desc } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BasicHead title={title} desc={desc} />
  </head>
  <body>
    <header>
      <TopNavigation />
    </header>
    <slot />
  </body>
</html>
